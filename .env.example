# Copy to .env for local use.
# Compose and the local server use these names. Production does not ship this file.

PORT=8080

# Host-side URL when Postgres is started with `docker compose up postgres`.
# Inside the app container Compose sets postgres://app:app@postgres:5432/app.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Set only when the process should talk to LocalStack. Leave unset in production.
# AWS_ENDPOINT_URL=http://127.0.0.1:4566
